autostart = "true"

configuration = JSON()
if not boolean("@PLUGIN_LISA_PATH@"):
	configuration.add("dbpath", "@PLUGIN_LISA_PATH@/dac_apps")
	configuration.add("appspath", "@PLUGIN_LISA_PATH@/dac_apps/apps")
	configuration.add("datapath", "@PLUGIN_LISA_PATH@/dac_apps/data")
configuration.add("annotationsFile", "config.json")
configuration.add("annotationsRegex", "public\\.*")
configuration.add("downloadRetryMaxTimes", "6")
configuration.add("downloadRetryAfterSeconds", "30")
